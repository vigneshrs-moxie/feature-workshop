{
  "name": "feature-workshop",
  "version": "0.1.0",
  "private": true,
  "description": "Local dashboard for the Claude Code feature workflow.",
  "type": "module",
  "bin": {
    "ground-control": "bin/ground-control.js"
  },
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "web"
  ],
  "scripts": {
    "start": "node dashboard/server.js",
    "demo": "node dashboard/demo/run-demo.js",
    "test": "node --test \"dashboard/test/*.test.js\"",
    "web:dev": "npm run dev -w web",
    "web:build": "npm run build -w web",
    "web:test": "npm run test -w web"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.296",
    "markdown-it": "15.0.2"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1"
  }
}
