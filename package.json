{
  "name": "@moxie/ground-control",
  "version": "0.1.0",
  "description": "Ground Control: run Claude Code feature jobs from one local dashboard.",
  "type": "module",
  "bin": {
    "ground-control": "bin/ground-control.js"
  },
  "files": [
    "bin/",
    "dashboard/",
    "!dashboard/test/",
    "!dashboard/demo/",
    "web/dist/",
    "service/",
    "install.sh",
    "install.ps1"
  ],
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "web"
  ],
  "scripts": {
    "start": "node dashboard/server.js",
    "demo": "node dashboard/demo/run-demo.js",
    "test": "node --test \"dashboard/test/*.test.js\"",
    "web:dev": "npm run dev -w web",
    "web:build": "npm run build -w web",
    "web:test": "npm run test -w web",
    "prepack": "npm run web:build"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.296",
    "@playwright/test": "1.64.1",
    "markdown-it": "15.0.2"
  }
}
