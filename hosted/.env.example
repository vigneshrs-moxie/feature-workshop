# The hosted site's settings (docs/hosting/vercel-setup.md step 2.4). On Vercel they are set in
# Settings → Environment Variables; DATABASE_URL comes from the Neon integration. For a local trial
# copy this file to hosted/.env.local and fill it in; never commit a value.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ALLOWED_DOMAIN=
SESSION_SECRET=
TOKEN_KEY=
CRON_SECRET=
OWNER_EMAIL=
ORBIT_BASE_URL=
SITE_URL=
DATABASE_URL=
# Only on a laptop, never on Vercel: the fake Google sign-in (a production build refuses it).
AUTH_FAKE=
